# ------------------------------------------------------------
# Visilux - reglas adicionales
# ------------------------------------------------------------

# Variables de entorno (nunca subir credenciales)
.env.*
!.env.example

# Archivos comprimidos / respaldos del proyecto (vendor.zip, visilux-combinado.zip, ...)
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.bak
*.backup
*.old
*.tmp
*.swp
*~

# Dependencias de Node / Composer y caches
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache
/.phpunit.cache
.php-cs-fixer.cache
/coverage

# Cache de Laravel generada
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/**/.gitignore

# Documentos privados subidos (camara de comercio, etc.)
/storage/app/private/*
!/storage/app/private/.gitignore

# Sistema operativo / editores
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
~$*
.vs/
*.code-workspace
